// Bitácora — the terminal of pleamar's desktop.
//
// The terminal is pleamar's own (`terminal`): a shell on a pty, drawn by the
// engine with these letters. Around it, what a terminal of this desktop has:
// tabs with a glyph of grains of their own, panes side by side or one under
// another as cards of mist, the desktop's colours (Calima's Taller, when it
// says them: the logic reads them), and a line under it all that says where
// you are and on which branch. The logic is bitacora.luau.
language 0.5

scene Bitacora {
    surface { size: 1120, 720; kind: window; title: "Bitácora"; app_id: "bitacora"; keyboard: on_demand }
    permissions { run: "git", "cat", "setsid", "pleamar-wm"; services: "env", "files", "files.write" }

    font file "fonts/JetBrainsMono-Variable.ttf"
    font file "fonts/JetBrainsMono-Italic-Variable.ttf"
    font file "fonts/Manrope-Variable.ttf"
    font file "fonts/Newsreader-Variable.ttf"

    // ── the look: the desktop's, when it says one ──
    fact th.ar = 0.498
    fact th.ag = 0.722
    fact th.ab = 0.643
    fact th.sr = 0.153
    fact th.sg = 0.173
    fact th.sb = 0.165
    fact th.ir = 0.882
    fact th.ig = 0.906
    fact th.ib = 0.898
    fact th.dk = 1
    fact th.round = 1
    let acc = rgb(th.ar, th.ag, th.ab)
    let surf = rgb(th.sr, th.sg, th.sb)
    let ink = rgb(th.ir, th.ig, th.ib)
    // Dark: the surface sunk into the night, as Calima's mist; light: the surface as it is.
    let bg = mix(surf, mix(#000000, surf, 0.62), th.dk)
    let paper = mix(mix(surf, ink, 0.025), mix(#000000, surf, 0.8), th.dk)
    let dim = mix(ink, bg, 0.36)
    let faint = mix(ink, bg, 0.6)
    // The caravan's colours (Calima's companions), each by its number, a little darker on a light desktop.
    let ASK = #e0a050
    let R = pick(th.round, 12, 8, 4)
    let Rs = pick(th.round, 9, 6, 3)
    let W = screen.width
    let H = screen.height

    // ── its terminals: twelve shells at most, in up to ten tabs (a whole caravan), up to four panes a tab ──
    fact zoom = 13.5
    // Where each pane is in its tab, as fractions of the body; its tab; whether it lives.
    repeat i in 0..12 {
        fact s.$i.on = 0
        fact s.$i.tab = -1
        fact s.$i.x = 0
        fact s.$i.y = 0
        fact s.$i.w = 1
        fact s.$i.h = 1
        // The bell: a glow on its edge, that fades.
        fact s.$i.ring = 0
        text s.$i.start = ""
        // What its shell's environment has of its own (the companion's name, in the first one).
        text s.$i.env = ""
        // An agent in it (pleamar-wm says): 0 none, 1 working, 2 ready, 3 asks you; and its companion's colour (-1: none).
        fact s.$i.ag = 0
        fact s.$i.tone = -1
        // What the terminal says (the engine fills them).
        fact term.$i.alive = 0
        fact term.$i.focus = 0
        fact term.$i.bell = 0
        fact term.$i.cols = 0
        fact term.$i.rows = 0
        fact term.$i.pid = 0
        fact term.$i.back = 0
        text term.$i.title = ""
        text term.$i.folder = ""
    }
    fact tab.cur = 0
    fact panes = 1                       // how many panes the tab in front has
    model tabs max 10 { name: text; here: bool; g0: number; g1: number; g2: number; g3: number; g4: number; ring: bool; ti: number; tone: number; ag: number }
    // A beat while an agent works or a wire carries something: the logic turns it, six steps a breath. (In steps,
    // not a spring: a spring that never rests would paint the whole window at the screen's rate for as long as an
    // agent works — 165 times a second for a dot.)
    fact beat = 0
    let pulse = pick(beat, 0, 0.35, 0.75, 1, 0.75, 0.35)
    // The line under it all: where, on which branch, how big.
    text st.where = ""
    text st.branch = ""
    text st.size = ""
    text st.what = ""
    fact st.git = false
    fact st.g0 = 0
    fact st.g1 = 0
    fact st.g2 = 0
    fact st.g3 = 0
    fact st.g4 = 0
    // A word that comes and goes (copied, a new window).
    text toast = ""
    fact toast.on = false

    event new_tab ->
    event close_pane ->
    event close_tab ->
    event split ->
    event go_tab ->
    event next_tab ->
    event move_focus ->
    event new_window ->
    event zoom_by ->
    event agent_beside ->
    // From outside (Calima: `pleamar --say bitacora-PID "emit show_layer N"`): the tab whose shell is that one, in front.
    event show_layer ->
    // From outside too (Calima's caravan): a tab of its own for a companion —its name, its folder, what to run—,
    // behind the one in front unless `open.front`.
    text open.name = ""
    text open.folder = ""
    text open.cmd = ""
    fact open.front = false
    event open_named ->
    event closed_all ->
    on closed_all { quit }

    // ── its shortcuts: the scene's, so the shells do not get them ──
    on key Ctrl+Shift+T { emit new_tab }
    on key Ctrl+Shift+W { emit close_pane }
    on key Ctrl+Shift+D { emit split(0) }
    on key Ctrl+Shift+E { emit split(1) }
    on key Ctrl+Shift+N { emit new_window }
    on key Ctrl+Tab { emit next_tab(1) }
    on key Ctrl+Shift+ISO_Left_Tab { emit next_tab(-1) }
    on key Ctrl+Next { emit next_tab(1) }
    on key Ctrl+Prior { emit next_tab(-1) }
    on key Alt+Left { emit move_focus(0) }
    on key Alt+Right { emit move_focus(1) }
    on key Alt+Up { emit move_focus(2) }
    on key Alt+Down { emit move_focus(3) }
    on key Ctrl+plus { emit zoom_by(1) }
    on key Ctrl+Shift+plus { emit zoom_by(1) }
    on key Ctrl+minus { emit zoom_by(-1) }
    on key Ctrl+equal { emit zoom_by(0) }
    on key Ctrl+Shift+equal { emit zoom_by(0) }
    on key Ctrl+Shift+A { emit agent_beside }

    // ═════════════════ the window ═════════════════
    box { from: 0, 0; size: W, H; color: bg }

    // ── the tabs ──
    let TOP = 46
    let BOT = 30
    group {
        clip box { from: 8, 4; size: W - 120, 40 }
        row tabrow { at: 12, 25; anchor: left middle; gap: 6
            for t in tabs {
                row tb { padding: 8; corner: Rs; gap: 8; cursor: pointer; fill: mix(bg, ink, if(t.here, 0.09, 0.025))
                    // A companion's tab: its colour.
                    let tk = max(t.tone, 0)
                    let tcol = mix(rgb(pick(tk, 0.851, 0.498, 0.761, 0.561, 0.725, 0.878, 0.651, 0.847), pick(tk, 0.627, 0.722, 0.482, 0.643, 0.761, 0.541, 0.561, 0.824), pick(tk, 0.400, 0.643, 0.561, 0.851, 0.482, 0.416, 0.851, 0.784)), ink, if(th.dk > 0.5, 0, 0.3))
                    // Its glyph: five rows of five grains, from the name of its folder (a companion's, its own).
                    group {
                        size: 13, 13
                        repeat g in 0..25 {
                            let gr0 = floor(g / 5)
                            let gc = mod(g, 5)
                            let row0 = pick(gr0, t.g0, t.g1, t.g2, t.g3, t.g4)
                            box { from: 2.6 * gc, 2.6 * gr0; size: 2, 2; corner: 0.5; color: if(t.tone >= 0, tcol, if(t.here, acc, dim)); opacity: if(mod(floor(row0 / pow(2, gc)), 2) > 0.5, if(t.here or t.tone >= 0, 100%, 70%), 14%) }
                        }
                    }
                    // (Many tabs, narrower names: they all fit.)
                    text t.name { size: 12.5; weight: if(t.here, 600, 500); family: "Manrope"; color: if(t.here, ink, dim); width: clamp((W - 200) / max(tabs.count, 1) - 72, 36, 150); tight: true; lines: 1 }
                    // Its agent: working, a dot that breathes; asking you, the amber one.
                    ellipse { radius: 3; color: if(t.tone >= 0, tcol, acc); opacity: 35% + 65% * pulse; show: t.ag == 1 }
                    ellipse { radius: 3.5; color: ASK; show: t.ag == 3 }
                    // A shell that rang, or an agent that finished, in a tab behind: a dot of the accent.
                    ellipse { radius: 3; color: acc; show: t.ring and not t.here and t.ag != 1 and t.ag != 3 }
                    row tx { padding: 2; corner: 6; cursor: pointer; show: tabs.count > 1
                        text "×" { size: 13; family: "Manrope"; color: faint }
                        on press tx { emit close_tab(t.ti) }
                    }
                    on press tb { emit go_tab(t.ti) }
                    on press middle tb { emit close_tab(t.ti) }
                }
            }
            row tplus { padding: 8; corner: Rs; cursor: pointer; fill: mix(bg, ink, 0.0); show: tabs.count < 10
                group {
                    size: 13, 13
                    box { from: 6, 1.5; size: 1.6, 10; corner: 0.8; color: dim }
                    box { from: 1.5, 6; size: 10, 1.6; corner: 0.8; color: dim }
                }
                on press tplus { emit new_tab }
            }
        }
    }
    // The right of the tabs: a pane beside, a pane below.
    group {
        component SplitBtn(k: number, x: number) {
            group {
                zone box b { from: x, 9; size: 32, 30; corner: Rs; cursor: pointer; active: panes < 4; label: pick(k, "A pane beside (Ctrl+Shift+D)", "A pane below (Ctrl+Shift+E)") }
                box { from: x, 9; size: 32, 30; corner: Rs; color: ink; opacity: 7% * b.hover }
                group {
                    opacity: if(panes < 4, 80%, 25%)
                    box { from: x + 8, 16; size: 16, 16; corner: 3.5; stroke: 1.4; color: dim }
                    box { from: x + 15.3, 17; size: 1.4, 14; color: dim; show: k == 0 }
                    box { from: x + 9, 23.3; size: 14, 1.4; color: dim; show: k == 1 }
                }
                on press b { emit split(k) }
            }
        }
        SplitBtn(0, W - 84)
        SplitBtn(1, W - 48)
    }

    // ── the panes: a card of mist each, the terminal in it ──
    let BX = 10
    let BY = TOP
    let BW = W - 20
    let BH = H - TOP - BOT
    repeat i in 0..12 {
        let here = s.$i.on > 0.5 and s.$i.tab == tab.cur
        let px = BX + s.$i.x * BW + 3
        let py = BY + s.$i.y * BH + 3
        let pw = s.$i.w * BW - 6
        let ph = s.$i.h * BH - 6
        let lit = term.$i.focus > 0.5
        let pk = max(s.$i.tone, 0)
        let ptone = mix(rgb(pick(pk, 0.851, 0.498, 0.761, 0.561, 0.725, 0.878, 0.651, 0.847), pick(pk, 0.627, 0.722, 0.482, 0.643, 0.761, 0.541, 0.561, 0.824), pick(pk, 0.400, 0.643, 0.561, 0.851, 0.482, 0.416, 0.851, 0.784)), ink, if(th.dk > 0.5, 0, 0.3))
        prop rg.$i = 0 ~calm
        follow rg.$i = s.$i.ring
        prop fo.$i = 0 ~quick
        follow fo.$i = if(lit and panes > 1, 1, 0)
        // A tab behind that has just been opened (a companion's, from outside): drawn out of sight until its shell
        // is up, as the engine starts the terminals it draws.
        let starting = s.$i.on > 0.5 and not here and term.$i.alive < 0.5
        group {
            show: here or starting
            move: if(here, 0, -40000), 0
            box { from: px, py; size: pw, ph; corner: R; color: paper }
            // The one with the keys, among several: its edge in the accent.
            // (A soft halo outside, the line itself inside.)
            box { from: px - 2, py - 2; size: pw + 4, ph + 4; corner: R + 2; stroke: 3; color: if(s.$i.ag == 3, ASK, if(s.$i.tone >= 0, ptone, acc)); opacity: 9% * fo.$i + 18% * rg.$i }
            box { from: px, py; size: pw, ph; corner: R; stroke: 1.2; color: if(s.$i.ag == 3, ASK, if(s.$i.tone >= 0, ptone, acc)); opacity: 58% * fo.$i + 70% * rg.$i }
            box { from: px, py; size: pw, ph; corner: R; stroke: 1; color: ink; opacity: 5% * (1 - fo.$i) * (1 - rg.$i) }
            terminal term.$i {
                at: px + 14, py + 10
                size: pw - 24, ph - 16
                family: "JetBrains Mono"
                font_size: zoom
                line_height: 1.28
                run: s.$i.on
                folder: s.$i.start
                env: s.$i.env
                // Ink and paper, then the sixteen: dark ones for a light desktop, light ones for a dark one.
                colors: ink, paper, mix(#3a3f45, #23272b, th.dk), mix(#b5483a, #e07a6c, th.dk), mix(#4d7a3f, #9cc48e, th.dk), mix(#93701f, #e3c07a, th.dk), mix(#3a62a0, #84a9e0, th.dk), mix(#83508f, #c493d6, th.dk), mix(#2e7f78, #7fc4bd, th.dk), mix(#6b6660, #d8d2c8, th.dk), mix(#6b7178, #5c6168, th.dk), mix(#c95646, #f09284, th.dk), mix(#5a8c4a, #b4d8a4, th.dk), mix(#a8822a, #f0d292, th.dk), mix(#4a74b4, #9fbff0, th.dk), mix(#9762a3, #d6abe6, th.dk), mix(#3a9088, #98d8d0, th.dk), mix(#2a2622, #f6f2ec, th.dk)
                cursor: acc
                selection: mix(paper, acc, 0.38)
                opacity: if(lit or panes < 2, 100%, 78%)
                label: "Terminal"
            }
        }
    }

    // ── an agent beside a pane, wired to it (`pleamar-wm term pair`): a knot of grains across the gap between
    // the two, that carries a wave while something goes along it or the agent works ──
    fact pair.a = -1
    fact pair.b = -1
    fact pair.flow = 0
    fact pair.st = 0
    let qa = max(pair.a, 0)
    let qb = max(pair.b, 0)
    group {
        show: pair.a >= 0 and pair.b >= 0 and s[qa].tab == tab.cur and s[qb].tab == tab.cur
        // Side by side (the edge between them is up and down), or one under the other.
        let side = abs(s[qa].x + s[qa].w - s[qb].x) < 0.01 or abs(s[qb].x + s[qb].w - s[qa].x) < 0.01
        let kx = if(side, BX + max(s[qa].x, s[qb].x) * BW, BX + (max(s[qa].x, s[qb].x) + min(s[qa].x + s[qa].w, s[qb].x + s[qb].w)) / 2 * BW)
        let ky = if(side, BY + (max(s[qa].y, s[qb].y) + min(s[qa].y + s[qa].h, s[qb].y + s[qb].h)) / 2 * BH, BY + max(s[qa].y, s[qb].y) * BH)
        let kw = if(side, 30, 12)
        let kh = if(side, 12, 30)
        // (Which way the wave goes: from the one that acts to the other.)
        let way = if(pair.flow < 0, -1, 1)
        box { from: kx - kw / 2, ky - kh / 2; size: kw, kh; corner: 6; color: mix(bg, ink, 0.1) }
        box { from: kx - kw / 2, ky - kh / 2; size: kw, kh; corner: 6; stroke: 1; color: if(pair.st == 3, ASK, acc); opacity: 55% }
        repeat g in 0..4 {
            let at = (g - 1.5) * 6
            let wave = clamp(1 - abs(if(way > 0, g, 3 - g) - beat * 0.8 + 0.5) / 1.4, 0, 1)
            let busy = pair.flow != 0 or pair.st == 1
            box { from: kx + if(side, at, 0) - 1.5, ky + if(side, 0, at) - 1.5; size: 3, 3; corner: 0.8; color: if(pair.st == 3, ASK, acc); opacity: if(busy, 30% + 70% * wave, 60%) }
        }
    }

    // ── the line under it all ──
    group {
        let ly = H - BOT / 2
        // Where: the folder of the shell with the keys, its glyph before it.
        repeat g in 0..25 {
            let gr0 = floor(g / 5)
            let gc = mod(g, 5)
            let row0 = pick(gr0, st.g0, st.g1, st.g2, st.g3, st.g4)
            box { from: 16 + 2.2 * gc, ly - 5.5 + 2.2 * gr0; size: 1.7, 1.7; corner: 0.4; color: acc; opacity: if(mod(floor(row0 / pow(2, gc)), 2) > 0.5, 90%, 14%) }
        }
        // (Narrow, the size goes and where you are takes less: the branch must fit.)
        let narrow = W < 520
        text st.where { at: 34, ly; anchor: left center; size: 11.5; family: "JetBrains Mono"; color: dim; width: W * if(narrow, 0.42, 0.55); lines: 1 }
        measure stw
        text st.where { at: -4000, -4000; size: 11.5; family: "JetBrains Mono"; opacity: 0%; measure: stw }
        group {
            show: st.git
            let bx2 = 34 + min(stw.width, W * if(narrow, 0.42, 0.55)) + 14
            // A branch: a small fork of grains.
            ellipse { at: bx2 + 3, ly - 3.5; radius: 1.6; color: acc }
            ellipse { at: bx2 + 3, ly + 3.5; radius: 1.6; color: acc }
            ellipse { at: bx2 + 8, ly - 3.5; radius: 1.6; color: acc; opacity: 70% }
            text st.branch { at: bx2 + 15, ly; anchor: left center; size: 11.5; family: "JetBrains Mono"; color: acc; width: max(min(200, W - bx2 - 15 - if(narrow, 14, 74)), 10); lines: 1 }
        }
        text st.what { at: W - 104, ly; anchor: right center; size: 11.5; family: "Manrope"; color: faint; width: W * 0.3; lines: 1; align: right; show: not narrow and W > 900 }
        text st.size { at: W - 18, ly; anchor: right center; size: 11.5; family: "JetBrains Mono"; color: faint; show: not narrow }
    }

    // ── looking for something in the history of the pane with the keys ──
    fact find.on = false
    fact find.s = 0
    fact find.miss = false
    text find.q = ""
    event find_go ->
    event find_close ->
    on key Ctrl+Shift+F { emit find_open }
    event find_open ->
    on key Escape while find.on { emit find_close }
    // (Enter: the one before, up the history, where what was just printed is not.)
    on submit find.q { emit find_go(0) }
    prop fp = 0 ~quick
    follow fp = if(find.on, 1, 0)
    let FW = 330
    let fx = BX + s[find.s].x * BW + s[find.s].w * BW - FW - 18
    let fy = BY + s[find.s].y * BH + 12
    group {
        show: fp > 0.01
        opacity: fp
        move: 0, -6 * (1 - fp)
        box { from: fx + 2, fy + 5; size: FW, 36; corner: 18; color: #000000; opacity: 20% }
        box { from: fx, fy; size: FW, 36; corner: 18; color: mix(bg, ink, 0.09) }
        box { from: fx, fy; size: FW, 36; corner: 18; stroke: 1; color: if(find.miss, #ef7a66, acc); opacity: if(find.miss, 55%, 35%) }
        // A lens of grains: a ring and its handle.
        ellipse { at: fx + 20, fy + 16.5; radius: 5.5; stroke: 1.5; color: dim }
        box { from: fx + 23.5, fy + 20.5; size: 1.6, 5.5; corner: 0.8; rotate: -45; color: dim }
        input find.q { at: fx + 36, fy + 9; width: FW - 132; size: 13; family: "Manrope"; color: ink; placeholder: "Find in its history"; selection: mix(paper, acc, 0.4) }
        text "Not found" { at: fx + FW - 102, fy + 18; anchor: right center; size: 11; weight: 600; family: "Manrope"; color: #ef7a66; show: find.miss }
        component FindBtn(k: number, x: number) {
            group {
                zone ellipse b { at: x, fy + 18; radius: 13; cursor: pointer; active: find.on; label: pick(k, "The one before (up)", "The next (down)", "Stop looking") }
                ellipse { at: x, fy + 18; radius: 13; color: ink; opacity: 9% * b.hover }
                path { at: x, fy + 18; stroke: 1.6; color: dim; show: k == 0; move -4.5, 2.5; line 0, -2.5; line 4.5, 2.5 }
                path { at: x, fy + 18; stroke: 1.6; color: dim; show: k == 1; move -4.5, -2.5; line 0, 2.5; line 4.5, -2.5 }
                path { at: x, fy + 18; stroke: 1.6; color: dim; show: k == 2; move -4, -4; line 4, 4 }
                path { at: x, fy + 18; stroke: 1.6; color: dim; show: k == 2; move 4, -4; line -4, 4 }
                on press b { emit find_go(k) }
            }
        }
        FindBtn(0, fx + FW - 82)
        FindBtn(1, fx + FW - 54)
        FindBtn(2, fx + FW - 24)
    }

    // ── a menu where a pane is pressed with the right button ──
    fact menu.on = false
    fact menu.x = 0
    fact menu.y = 0
    fact menu.s = 0
    event menu_do ->
    repeat i in 0..12 {
        on press right term.$i {
            menu.x = pointer.x
            menu.y = pointer.y
            menu.s = i
            menu.on = true
        }
    }
    on key Escape while menu.on { menu.on = false }
    prop mp = 0 ~quick
    follow mp = if(menu.on, 1, 0)
    // (Pressing anywhere else closes it.)
    zone box shield { from: 0, 0; size: W, H; active: menu.on; agent: hidden }
    on press shield { menu.on = false }
    on press right shield { menu.on = false }
    let MW = 236
    let MH = 12 * 30 + 2 * 9 + 12
    let mx = clamp(menu.x, 8, W - MW - 8)
    let my = clamp(menu.y, 8, H - MH - 8)
    group {
        show: mp > 0.01
        opacity: mp
        move: 0, -6 * (1 - mp)
        box { from: mx + 2, my + 6; size: MW, MH; corner: R; color: #000000; opacity: 22% }
        box { from: mx, my; size: MW, MH; corner: R; color: mix(bg, ink, 0.075) }
        box { from: mx, my; size: MW, MH; corner: R; stroke: 1; color: ink; opacity: 9% }
        component Item(k: number, y: number, label: text, hint: text) {
            group {
                zone box b { from: mx + 6, y; size: MW - 12, 28; corner: Rs; cursor: pointer; active: menu.on; label: label }
                box { from: mx + 6, y; size: MW - 12, 28; corner: Rs; color: acc; opacity: 16% * b.hover }
                text label { at: mx + 16, y + 14; anchor: left center; size: 12.5; weight: 500; family: "Manrope"; color: ink }
                text hint { at: mx + MW - 16, y + 14; anchor: right center; size: 10.5; family: "JetBrains Mono"; color: faint }
                on press b { emit menu_do(k) }
            }
        }
        Item(0, my + 6, "Copy", "Ctrl+Shift+C")
        Item(1, my + 36, "Paste", "Ctrl+Shift+V")
        Item(2, my + 66, "Select all", "")
        Item(9, my + 96, "Find", "Ctrl+Shift+F")
        Item(10, my + 126, "Send to…", "")
        box { from: mx + 14, my + 159; size: MW - 28, 1; color: ink; opacity: 8% }
        Item(3, my + 165, "Pane beside", "Ctrl+Shift+D")
        Item(4, my + 195, "Pane below", "Ctrl+Shift+E")
        Item(11, my + 225, "Agent beside", "Ctrl+Shift+A")
        Item(5, my + 255, "New tab", "Ctrl+Shift+T")
        box { from: mx + 14, my + 288; size: MW - 28, 1; color: ink; opacity: 8% }
        Item(6, my + 294, "Forget its history", "")
        Item(7, my + 324, "New window", "Ctrl+Shift+N")
        Item(8, my + 354, "Close pane", "Ctrl+Shift+W")
    }

    // ── «Send to…»: what is selected, as a letter to one of the caravan's companions (Calima's) ──
    fact send.on = false
    model comps max 10 { name: text; tone: number; g0: number; g1: number; g2: number; g3: number; g4: number; busy: bool; ci: number }
    event send_to ->
    on key Escape while send.on { send.on = false }
    zone box shield2 { from: 0, 0; size: W, H; active: send.on; agent: hidden }
    on press shield2 { send.on = false }
    prop sp = 0 ~quick
    follow sp = if(send.on, 1, 0)
    let SH = 40 + max(comps.count, 1) * 30 + 8
    let sx = clamp(menu.x, 8, W - MW - 8)
    let sy = clamp(menu.y, 8, H - SH - 8)
    group {
        show: sp > 0.01
        opacity: sp
        move: 0, -6 * (1 - sp)
        box { from: sx + 2, sy + 6; size: MW, SH; corner: R; color: #000000; opacity: 22% }
        box { from: sx, sy; size: MW, SH; corner: R; color: mix(bg, ink, 0.075) }
        box { from: sx, sy; size: MW, SH; corner: R; stroke: 1; color: ink; opacity: 9% }
        text "Send what is selected to" { at: sx + 16, sy + 21; anchor: left center; size: 11; weight: 600; family: "Manrope"; color: faint }
        text "No companions: Calima's caravan has none" { at: sx + 16, sy + 54; anchor: left center; size: 12; family: "Manrope"; color: dim; width: MW - 32; lines: 1; show: comps.count == 0 }
        column { at: sx + 6, sy + 38; gap: 2
            for c in comps {
                row cr { size: MW - 12, 28; padding: 10; gap: 10; corner: Rs; cursor: pointer
                    let ck = max(c.tone, 0)
                    let ccol = mix(rgb(pick(ck, 0.851, 0.498, 0.761, 0.561, 0.725, 0.878, 0.651, 0.847), pick(ck, 0.627, 0.722, 0.482, 0.643, 0.761, 0.541, 0.561, 0.824), pick(ck, 0.400, 0.643, 0.561, 0.851, 0.482, 0.416, 0.851, 0.784)), ink, if(th.dk > 0.5, 0, 0.3))
                    group {
                        size: 11, 11
                        repeat g in 0..25 {
                            let gr0 = floor(g / 5)
                            let gc = mod(g, 5)
                            let row0 = pick(gr0, c.g0, c.g1, c.g2, c.g3, c.g4)
                            box { from: 2.2 * gc, 2.2 * gr0; size: 1.7, 1.7; corner: 0.4; color: ccol; opacity: if(mod(floor(row0 / pow(2, gc)), 2) > 0.5, 100%, 14%) }
                        }
                    }
                    text c.name { size: 12.5; weight: 500; family: "Manrope"; color: ink; width: MW - 80; tight: true; lines: 1 }
                    ellipse { radius: 2.5; color: ccol; opacity: 35% + 65% * pulse; show: c.busy }
                    on press cr { emit send_to(c.ci) }
                }
            }
        }
    }

    // ── a word that comes and goes ──
    prop tp = 0 ~calm
    follow tp = if(toast.on, 1, 0)
    group {
        show: tp > 0.01
        opacity: tp
        move: 0, 8 * (1 - tp)
        measure tm
        text toast { at: -4000, -4000; size: 12.5; family: "Manrope"; opacity: 0%; measure: tm }
        box { from: W / 2 - tm.width / 2 - 16, H - BOT - 52; size: tm.width + 32, 34; corner: 17; color: mix(bg, ink, 0.12) }
        text toast { at: W / 2, H - BOT - 35; anchor: center; size: 12.5; weight: 600; family: "Manrope"; color: ink }
    }

    translations es {
        "Copy" = "Copiar"
        "Ctrl+Shift+C" = "Ctrl+Mayús+C"
        "Ctrl+Shift+V" = "Ctrl+Mayús+V"
        "Ctrl+Shift+D" = "Ctrl+Mayús+D"
        "Ctrl+Shift+E" = "Ctrl+Mayús+E"
        "Ctrl+Shift+T" = "Ctrl+Mayús+T"
        "Ctrl+Shift+N" = "Ctrl+Mayús+N"
        "Ctrl+Shift+W" = "Ctrl+Mayús+W"
        "Paste" = "Pegar"
        "Select all" = "Seleccionar todo"
        "Pane beside" = "Panel al lado"
        "Pane below" = "Panel debajo"
        "New tab" = "Pestaña nueva"
        "Forget its history" = "Olvidar su historial"
        "New window" = "Ventana nueva"
        "Close pane" = "Cerrar el panel"
        "Terminal" = "Terminal"
        "A pane beside (Ctrl+Shift+D)" = "Un panel al lado (Ctrl+Mayús+D)"
        "A pane below (Ctrl+Shift+E)" = "Un panel debajo (Ctrl+Mayús+E)"
        "Ten tabs at most: close one first" = "Diez pestañas como mucho: cierra una antes"
        "Twelve shells at most: close one first" = "Doce terminales como mucho: cierra una antes"
        "Four panes a tab at most" = "Cuatro paneles por pestaña como mucho"
        "A new window" = "Una ventana nueva"
        "A new window could not be opened" = "No se pudo abrir una ventana nueva"
        "Copied" = "Copiado"
        "Nothing is selected" = "No hay nada seleccionado"
        "History forgotten" = "Historial olvidado"
        "Find in its history" = "Buscar en su historial"
        "Not found" = "No está"
        "The one before (up)" = "La anterior (arriba)"
        "The next (down)" = "La siguiente (abajo)"
        "Stop looking" = "Dejar de buscar"
        "Find" = "Buscar"
        "Ctrl+Shift+F" = "Ctrl+Mayús+F"
        "Ctrl+Shift+A" = "Ctrl+Mayús+A"
        "Send to…" = "Enviar a…"
        "Agent beside" = "Agente al lado"
        "Send what is selected to" = "Enviar lo seleccionado a"
        "No companions: Calima's caravan has none" = "No hay compañeros: la caravana de Calima no tiene"
        "Select something first (with Shift, where the program takes the mouse)" = "Selecciona algo antes (con Mayús, si el programa usa el ratón)"
        "Sent to %s" = "Enviado a %s"
        "%s did not get it: %s" = "%s no lo recibió: %s"
        "From my terminal, in %s:" = "Desde mi terminal, en %s:"
        "working" = "trabajando"
        "asks you" = "te pregunta"
        "ready" = "listo"
        "Agent" = "Agente"
        "An agent beside, wired to this pane" = "Un agente al lado, con cable a este panel"
        "The agent could not be wired to this pane" = "No se pudo poner el cable entre el agente y este panel"
    }
}
